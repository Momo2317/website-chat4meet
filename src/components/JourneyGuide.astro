---
import { journeySteps } from "../config/site";
---

<section id="journey" class="border-b border-surface-border bg-surface-soft py-10" aria-label="Product tour progress">
  <div class="site-shell">
    <div class="reveal mx-auto max-w-3xl text-center">
      <h2 class="text-2xl font-bold tracking-tight text-ink md:text-3xl">
        A short guided tour
      </h2>
      <p class="mt-3 text-ink-muted">
        Follow Chat → Stories → Profiles. Each step is one piece of how Chat4Meet keeps people close.
      </p>
    </div>

    <ol class="reveal reveal-delay-1 mt-8 flex flex-wrap items-center justify-center gap-3" data-guide-list>
      {
        journeySteps.map((step, index) => (
          <li>
            <a
              href={`#${step.id}`}
              class="guide-dot inline-block align-middle"
              data-guide-dot={step.id}
              aria-label={`Go to ${step.label}`}
              title={`${index + 1}. ${step.label}`}
            >
              <span class="sr-only">{step.label}</span>
            </a>
          </li>
        ))
      }
    </ol>

    <div class="reveal reveal-delay-2 mt-6 flex flex-wrap justify-center gap-2 md:gap-3">
      {
        journeySteps.map((step, index) => (
          <a
            href={`#${step.id}`}
            class="rounded-full border border-surface-border bg-white px-4 py-2 text-sm font-medium text-ink transition hover:border-brand hover:text-brand"
            data-guide-chip={step.id}
          >
            {index + 1}. {step.label}
          </a>
        ))
      }
    </div>
  </div>
</section>
