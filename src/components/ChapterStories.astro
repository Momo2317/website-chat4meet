---
import { Image } from "astro:assets";
import { journeySteps } from "../config/site";
import story1 from "../assets/brand/stories/story_1.png";
import story2 from "../assets/brand/stories/story_2.png";
import story3 from "../assets/brand/stories/story_3.png";
import story4 from "../assets/brand/stories/story_4.png";
import story5 from "../assets/brand/stories/story_5.png";

const step = journeySteps[1];
const rings = [
  { img: story1, name: "Alex" },
  { img: story2, name: "Maya" },
  { img: story3, name: "Jules" },
  { img: story4, name: "Sam" },
  { img: story5, name: "Riley" },
];
---

<section
  id={step.id}
  class="scroll-mt-24 overflow-hidden bg-brand py-20 text-white md:py-28"
  aria-labelledby="stories-heading"
>
  <div class="ambient-orb -right-10 top-16 h-72 w-72 bg-white/20"></div>
  <div class="site-shell relative grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div class="reveal">
      <div
        class="story-carousel"
        data-story-carousel
        role="region"
        aria-roledescription="carousel"
        aria-label="Chat4Meet stories"
      >
        <div
          class="mb-6 flex gap-4 overflow-x-auto pb-1 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          role="tablist"
          aria-label="Story people"
        >
          {
            rings.map((ring, i) => (
              <button
                type="button"
                role="tab"
                class="story-ring-btn flex w-[72px] shrink-0 flex-col items-center gap-2"
                data-story-tab={i}
                aria-selected={i === 0 ? "true" : "false"}
                aria-controls={`story-slide-${i}`}
                id={`story-tab-${i}`}
              >
                <span class="story-ring block">
                  <Image
                    src={ring.img}
                    alt=""
                    width={66}
                    height={66}
                    class="h-[66px] w-[66px] object-cover"
                  />
                </span>
                <span class="text-xs text-white/80">{ring.name}</span>
              </button>
            ))
          }
        </div>

        <div class="overflow-hidden rounded-[1.5rem] border border-white/20 shadow-lift">
          <div class="story-track" data-story-track>
            {
              rings.map((ring, i) => (
                <div
                  class="story-slide"
                  id={`story-slide-${i}`}
                  role="tabpanel"
                  aria-labelledby={`story-tab-${i}`}
                  data-story-slide={i}
                >
                  <Image
                    src={ring.img}
                    alt={`${ring.name}'s Chat4Meet story`}
                    width={720}
                    height={900}
                    class="aspect-[4/5] w-full object-cover"
                    loading={i === 0 ? "eager" : "lazy"}
                  />
                </div>
              ))
            }
          </div>
        </div>

        <div class="mt-5 flex items-center justify-between gap-3">
          <button
            type="button"
            class="rounded-full border border-white/40 px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/10"
            data-story-prev
            aria-label="Previous story"
          >
            ← Prev
          </button>
          <p class="text-sm text-white/75" data-story-status aria-live="polite">
            1 / {rings.length}
          </p>
          <button
            type="button"
            class="rounded-full border border-white/40 px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/10"
            data-story-next
            aria-label="Next story"
          >
            Next →
          </button>
        </div>
      </div>
    </div>

    <div class="reveal reveal-delay-1">
      <h2 id="stories-heading" class="text-3xl font-bold tracking-tight md:text-4xl">
        {step.label}: {step.title}
      </h2>
      <p class="mt-4 max-w-prose text-[17px] leading-relaxed text-white/80">
        {step.description}
      </p>
      <ul class="mt-8 space-y-3">
        {
          step.points.map((point) => (
            <li class="flex gap-3 text-[15px] text-white">
              <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-white" aria-hidden="true" />
              <span>{point}</span>
            </li>
          ))
        }
      </ul>
      <a
        href="#profiles"
        class="mt-10 inline-flex items-center gap-2 text-sm font-semibold text-white transition hover:gap-3"
      >
        Next: Profiles
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
