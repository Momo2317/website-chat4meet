---
import { features } from "../config/site";
---

<section class="bg-surface px-6 py-20" aria-labelledby="features-heading">
  <div class="mx-auto max-w-5xl">
    <h2 id="features-heading" class="text-center text-2xl font-bold tracking-tight text-ink md:text-3xl">
      Alles für deine Verbindungen
    </h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-ink-muted">
      Chat4Meet bündelt Chat, Stories und Profile in einer klaren Oberfläche — so wie in der App.
    </p>
    <ul class="mt-14 grid gap-8 sm:grid-cols-3">
      {
        features.map((feature) => (
          <li class="rounded-2xl border border-surface-border bg-surface-soft p-8">
            <h3 class="text-lg font-semibold text-ink">{feature.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-ink-muted">{feature.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
