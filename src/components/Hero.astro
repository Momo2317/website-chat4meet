---
import { Image } from "astro:assets";
import { site } from "../config/site";
import heroIcon from "../assets/brand/chat-logo-hero-white.svg?url";
import wordmark from "../assets/brand/chat4meet_white_logo.png";
---

<section
  class="relative flex min-h-[min(88vh,720px)] flex-col items-center justify-center bg-brand px-6 pb-16 pt-14 text-center text-white"
  aria-labelledby="hero-heading"
>
  <img
    src={heroIcon}
    alt=""
    width={72}
    height={72}
    class="mb-5 h-[72px] w-[72px]"
    aria-hidden="true"
    loading="eager"
    decoding="async"
  />
  <Image
    src={wordmark}
    alt={site.name}
    width={240}
    height={80}
    class="mx-auto h-auto w-[min(240px,70vw)]"
    loading="eager"
    decoding="async"
  />
  <p id="hero-heading" class="mt-6 max-w-md text-lg leading-relaxed text-white/80">
    {site.tagline}
  </p>
</section>
