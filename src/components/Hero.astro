---
import { Image } from "astro:assets";
import { site } from "../config/site";
import IphoneMockup from "./IphoneMockup.astro";
import wordmark from "../assets/brand/chat4meet_white_logo.png";
import mark from "../assets/brand/chat_logo_1024x1024_009c9c.png";
import alex from "../assets/photos/person-alex.jpg";
import maya from "../assets/photos/person-maya.jpg";
import jules from "../assets/photos/person-jules.jpg";
import sceneStories from "../assets/photos/scene-stories.jpg";
---

<section
  id="top"
  class="relative overflow-hidden bg-brand pb-16 pt-28 text-white md:pb-24 md:pt-32"
  aria-labelledby="hero-heading"
>
  <div class="ambient-orb -left-16 top-24 h-64 w-64 bg-white/30"></div>
  <div
    class="ambient-orb right-[-4rem] top-40 h-80 w-80 bg-[#7adede]/50"
    style="animation-delay: -4s"
  >
  </div>

  <div class="site-shell relative grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-10">
    <div class="hero-rise text-center lg:text-left">
      <Image
        src={wordmark}
        alt={site.name}
        width={280}
        height={94}
        class="mx-auto h-auto w-[min(260px,72vw)] lg:mx-0"
        loading="eager"
        decoding="async"
      />
      <h1
        id="hero-heading"
        class="mt-8 max-w-xl text-4xl font-bold leading-[1.12] tracking-tight md:text-5xl lg:max-w-none"
      >
        {site.heroTitle}
      </h1>
      <p class="mx-auto mt-5 max-w-lg text-lg leading-relaxed text-white/80 lg:mx-0">
        {site.heroSubtitle}
      </p>
      <div class="mt-9 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start">
        <a href="#journey" class="cta-primary bg-white text-brand hover:bg-white/95">
          Take the tour
        </a>
        <a href="#download" class="cta-secondary">
          Get the app
        </a>
      </div>
      <p class="mt-6 text-sm text-white/70">{site.tagline}</p>
    </div>

    <div class="relative mx-auto w-full max-w-[320px]">
      <IphoneMockup>
        <div class="phone-ui">
          <Image
            src={sceneStories}
            alt="Friends sharing a moment in Chat4Meet"
            width={720}
            height={1280}
            class="phone-ui__photo"
            loading="eager"
            decoding="async"
          />
          <div class="phone-ui__shade" aria-hidden="true"></div>
          <div class="phone-ui__chrome">
            <div class="phone-ui__top">
              <Image src={mark} alt="" width={28} height={28} class="h-7 w-7 rounded-lg" />
              <div>
                <p class="text-[13px] font-semibold leading-none text-white">{site.name}</p>
                <p class="mt-1 text-[11px] text-white/75">Stories · live</p>
              </div>
            </div>
            <div class="phone-ui__avatars">
              {
                [
                  { img: alex, name: "Alex" },
                  { img: maya, name: "Maya" },
                  { img: jules, name: "Jules" },
                ].map((person) => (
                  <figure class="flex flex-col items-center gap-1">
                    <span class="story-ring block scale-90">
                      <Image
                        src={person.img}
                        alt=""
                        width={44}
                        height={44}
                        class="h-11 w-11 object-cover"
                      />
                    </span>
                    <figcaption class="text-[10px] text-white/85">{person.name}</figcaption>
                  </figure>
                ))
              }
            </div>
            <div class="phone-ui__bubble">
              Let’s meet after work — same café as last time?
            </div>
          </div>
        </div>
      </IphoneMockup>
    </div>
  </div>
</section>

<style>
  .phone-ui {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 100%;
  }

  .phone-ui__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .phone-ui__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 70, 70, 0.55) 0%,
      rgba(0, 40, 40, 0.15) 35%,
      rgba(0, 20, 20, 0.2) 60%,
      rgba(0, 30, 30, 0.75) 100%
    );
  }

  .phone-ui__chrome {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
            padding: 2.4rem 0.85rem 1rem;
  }

  .phone-ui__top {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .phone-ui__avatars {
    display: flex;
    gap: 0.65rem;
    margin-top: 0.85rem;
  }

  .phone-ui__bubble {
    margin-top: auto;
    align-self: flex-end;
    max-width: 85%;
    border-radius: 1.1rem 1.1rem 0.35rem 1.1rem;
    background: #009c9c;
    padding: 0.7rem 0.85rem;
    font-size: 0.8rem;
    line-height: 1.35;
    color: #fff;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.25);
  }
</style>
