---
import { site } from "../config/site";

const iconSrc = `${import.meta.env.BASE_URL}brand/chat-logo-navigation-icon.svg`;
const wordmarkSrc = `${import.meta.env.BASE_URL}brand/chat4meet_white_logo.png`;
---

<section
  class="relative flex min-h-[min(88vh,720px)] flex-col items-center justify-center bg-brand px-6 pb-16 pt-14 text-center text-white"
  aria-labelledby="hero-heading"
>
  <img
    src={iconSrc}
    alt=""
    width="72"
    height="72"
    class="mb-5 h-[72px] w-[72px] brightness-0 invert"
    aria-hidden="true"
  />
  <img
    src={wordmarkSrc}
    alt={site.name}
    width="240"
    height="80"
    class="mx-auto h-auto w-[min(240px,70vw)]"
  />
  <p id="hero-heading" class="mt-6 max-w-md text-lg leading-relaxed text-white/80">
    {site.tagline}
  </p>
</section>
