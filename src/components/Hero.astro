---
import { Image } from "astro:assets";
import { site } from "../config/site";
import IphoneMockup from "./IphoneMockup.astro";
import wordmark from "../assets/brand/chat4meet_white_logo.png";
import mark from "../assets/brand/chat_logo_1024x1024_009c9c.png";

const storyPeople = [
  { initial: "A", name: "Alex", tone: "#0d9488" },
  { initial: "M", name: "Maya", tone: "#0891b2" },
  { initial: "J", name: "Jules", tone: "#059669" },
] as const;
---

<section
  id="top"
  class="relative overflow-hidden bg-brand pb-16 pt-28 text-white md:pb-24 md:pt-32"
  aria-labelledby="hero-heading"
>
  <div class="ambient-orb -left-16 top-24 h-64 w-64 bg-white/30"></div>
  <div
    class="ambient-orb right-[-4rem] top-40 h-80 w-80 bg-[#7adede]/50"
    style="animation-delay: -4s"
  >
  </div>

  <div class="site-shell relative grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-10">
    <div class="hero-rise text-center lg:text-left">
      <Image
        src={wordmark}
        alt={site.name}
        width={280}
        height={94}
        class="mx-auto h-auto w-[min(260px,72vw)] lg:mx-0"
        loading="eager"
        decoding="async"
      />
      <h1
        id="hero-heading"
        class="mt-8 max-w-xl text-4xl font-bold leading-[1.12] tracking-tight md:text-5xl lg:max-w-none"
      >
        {site.heroTitle}
      </h1>
      <p class="mx-auto mt-5 max-w-lg text-lg leading-relaxed text-white/80 lg:mx-0">
        {site.heroSubtitle}
      </p>
      <div class="mt-9 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start">
        <a href="#journey" class="cta-primary bg-white text-brand hover:bg-white/95">
          Take the tour
        </a>
        <a href="#download" class="cta-secondary">
          Get the app
        </a>
      </div>
      <p class="mt-6 text-sm text-white/70">{site.tagline}</p>
    </div>

    <div class="relative mx-auto w-full max-w-[300px]">
      <IphoneMockup>
        <div class="chat-ui">
          <header class="chat-ui__header">
            <Image src={mark} alt="" width={32} height={32} class="h-8 w-8 rounded-xl" />
            <div>
              <p class="text-[13px] font-semibold leading-none text-white">{site.name}</p>
              <p class="mt-1 text-[11px] text-white/75">Online · close friends</p>
            </div>
          </header>

          <div class="chat-ui__body">
            <div class="chat-ui__stories" aria-hidden="true">
              {
                storyPeople.map((person) => (
                  <figure class="flex w-12 flex-col items-center gap-1">
                    <span class="story-ring block">
                      <span
                        class="flex h-11 w-11 items-center justify-center rounded-full text-sm font-semibold text-white"
                        style={`background:${person.tone}`}
                      >
                        {person.initial}
                      </span>
                    </span>
                    <figcaption class="text-[10px] text-ink-muted">{person.name}</figcaption>
                  </figure>
                ))
              }
            </div>

            <div class="chat-ui__thread">
              <div class="chat-ui__row">
                <span class="chat-ui__avatar" style="background:#0d9488">M</span>
                <div class="chat-ui__bubble chat-ui__bubble--in">
                  Are you free after 7?
                </div>
              </div>
              <div class="chat-ui__bubble chat-ui__bubble--out">
                Yes — same café as last time?
              </div>
              <div class="chat-ui__row">
                <span class="chat-ui__avatar" style="background:#0d9488">M</span>
                <div class="chat-ui__bubble chat-ui__bubble--in">
                  Perfect. I’ll send a story when I’m nearby.
                </div>
              </div>
            </div>

            <div class="chat-ui__composer">Message…</div>
          </div>
        </div>
      </IphoneMockup>
    </div>
  </div>
</section>

<style>
  .chat-ui {
    display: flex;
    height: 100%;
    flex-direction: column;
    background: #f4fbfb;
  }

  .chat-ui__header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: #009c9c;
    padding: 2rem 0.85rem 0.85rem;
  }

  .chat-ui__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.75rem 0.7rem 0.7rem;
    min-height: 0;
  }

  .chat-ui__stories {
    display: flex;
    gap: 0.55rem;
    overflow: hidden;
  }

  .chat-ui__thread {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.55rem;
    justify-content: flex-end;
    min-height: 0;
  }

  .chat-ui__row {
    display: flex;
    align-items: flex-end;
    gap: 0.4rem;
  }

  .chat-ui__avatar {
    display: inline-flex;
    height: 1.55rem;
    width: 1.55rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    font-size: 0.65rem;
    font-weight: 600;
    color: #fff;
  }

  .chat-ui__bubble {
    max-width: 82%;
    padding: 0.55rem 0.7rem;
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .chat-ui__bubble--in {
    border-radius: 1rem 1rem 1rem 0.3rem;
    background: #fff;
    color: #111418;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06);
  }

  .chat-ui__bubble--out {
    align-self: flex-end;
    border-radius: 1rem 1rem 0.3rem 1rem;
    background: #009c9c;
    color: #fff;
    box-shadow: 0 8px 18px rgb(0 100 100 / 0.22);
  }

  .chat-ui__composer {
    margin-top: auto;
    border: 1px solid #d7ecec;
    border-radius: 1rem;
    background: #fff;
    padding: 0.55rem 0.75rem;
    font-size: 0.72rem;
    color: #6b7280;
  }
</style>
