---
import { Image } from "astro:assets";
import { site } from "../config/site";
import wordmark from "../assets/brand/chat4meet_white_logo.png";
import story1 from "../assets/brand/stories/story_1.png";
import story2 from "../assets/brand/stories/story_2.png";
import story3 from "../assets/brand/stories/story_3.png";
import mark from "../assets/brand/chat_logo_1024x1024_009c9c.png";
---

<section
  id="top"
  class="relative overflow-hidden bg-brand pb-20 pt-28 text-white md:pb-28 md:pt-32"
  aria-labelledby="hero-heading"
>
  <div class="ambient-orb -left-16 top-24 h-64 w-64 bg-white/30"></div>
  <div
    class="ambient-orb right-[-4rem] top-40 h-80 w-80 bg-[#7adede]/50"
    style="animation-delay: -4s"
  >
  </div>
  <div
    class="ambient-orb bottom-10 left-1/3 h-52 w-52 bg-brand-deep/60"
    style="animation-delay: -8s"
  >
  </div>

  <div class="site-shell relative grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr]">
    <div class="hero-rise text-center lg:text-left">
      <Image
        src={wordmark}
        alt={site.name}
        width={280}
        height={94}
        class="mx-auto h-auto w-[min(260px,72vw)] lg:mx-0"
        loading="eager"
        decoding="async"
      />
      <h1
        id="hero-heading"
        class="mt-8 max-w-xl text-4xl font-bold leading-[1.12] tracking-tight md:text-5xl lg:max-w-none"
      >
        {site.heroTitle}
      </h1>
      <p class="mx-auto mt-5 max-w-lg text-lg leading-relaxed text-white/80 lg:mx-0">
        {site.heroSubtitle}
      </p>
      <div class="mt-9 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start">
        <a href="#journey" class="cta-primary bg-white text-brand hover:bg-white/95">
          Take the tour
        </a>
        <a href="#download" class="cta-secondary">
          Get the app
        </a>
      </div>
      <p class="mt-6 text-sm text-white/70">{site.tagline}</p>
    </div>

    <div class="hero-rise relative mx-auto flex justify-center" style="animation-delay: 120ms">
      <div class="phone-shell">
        <div class="phone-screen flex flex-col">
          <div class="flex items-center gap-3 bg-brand px-4 pb-4 pt-8 text-white">
            <Image src={mark} alt="" width={36} height={36} class="h-9 w-9 rounded-xl" />
            <div class="text-left">
              <p class="text-sm font-semibold leading-none">{site.name}</p>
              <p class="mt-1 text-xs text-white/75">Online · 3 close friends</p>
            </div>
          </div>
          <div class="flex flex-1 flex-col gap-3 bg-[#f4fbfb] p-4">
            <div class="flex gap-3 overflow-hidden pb-1">
              {
                [story1, story2, story3].map((img) => (
                  <div class="story-ring shrink-0">
                    <Image src={img} alt="" width={52} height={52} class="h-[52px] w-[52px] object-cover" />
                  </div>
                ))
              }
            </div>
            <div class="ml-auto max-w-[78%] rounded-2xl rounded-br-md bg-brand px-3.5 py-2.5 text-left text-sm leading-snug text-white shadow-soft">
              Let’s meet after work — same café as last time?
            </div>
            <div class="max-w-[78%] rounded-2xl rounded-bl-md bg-white px-3.5 py-2.5 text-left text-sm leading-snug text-ink shadow-sm">
              Perfect. I’ll send a story when I’m nearby.
            </div>
            <div class="mt-auto rounded-2xl border border-surface-border bg-white px-3 py-2.5 text-left text-xs text-ink-muted">
              Message…
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <a
    href="#journey"
    class="scroll-cue mx-auto mt-14 flex h-10 w-6 flex-col items-center justify-end rounded-full border border-white/40 pb-1.5"
    aria-label="Scroll to the product tour"
  >
    <span class="block h-2 w-0.5 rounded-full bg-white"></span>
  </a>
</section>
