---
import { site } from "../config/site";
---

<section class="border-y border-surface-border bg-surface-soft px-6 py-16" aria-labelledby="trust-heading">
  <div class="mx-auto max-w-2xl text-center">
    <h2 id="trust-heading" class="text-xl font-semibold text-ink">
      Sicher und direkt
    </h2>
    <p class="mt-4 text-[17px] leading-relaxed text-ink-muted">
      {site.tagline} Chat4Meet ist darauf ausgelegt, echte Gespräche und geteilte Momente ohne
      unnötigen Ballast zu ermöglichen — klar, vertraut und nah an dem, was du aus der App
      kennst.
    </p>
  </div>
</section>
