---
import { site } from "../config/site";
const { appStore, playStore, storesAvailable } = site.storeLinks;
---

<section class="bg-surface px-6 py-20" aria-labelledby="download-heading">
  <div class="mx-auto max-w-lg text-center">
    <h2 id="download-heading" class="text-2xl font-bold text-ink">
      App herunterladen
    </h2>
    <p class="mt-3 text-ink-muted">
      {
        storesAvailable
          ? "Hol dir Chat4Meet im App Store oder bei Google Play."
          : "Die Store-Links folgen in Kürze — die Buttons sind vorbereitet."
      }
    </p>
    <div class="mt-10 flex flex-col items-stretch justify-center gap-4 sm:flex-row sm:items-center">
      <a
        href={appStore}
        class:list={[
          "inline-flex min-h-12 items-center justify-center rounded-full px-8 text-[15px] font-semibold transition-colors",
          storesAvailable
            ? "bg-ink text-white hover:bg-ink/90"
            : "pointer-events-none cursor-not-allowed bg-surface-border text-ink-muted",
        ]}
        aria-disabled={!storesAvailable}
        tabindex={storesAvailable ? 0 : -1}
      >
        App Store
      </a>
      <a
        href={playStore}
        class:list={[
          "inline-flex min-h-12 items-center justify-center rounded-full border-2 border-brand px-8 text-[15px] font-semibold transition-colors",
          storesAvailable
            ? "text-brand hover:bg-brand hover:text-white"
            : "pointer-events-none cursor-not-allowed border-surface-border text-ink-muted",
        ]}
        aria-disabled={!storesAvailable}
        tabindex={storesAvailable ? 0 : -1}
      >
        Google Play
      </a>
    </div>
  </div>
</section>
