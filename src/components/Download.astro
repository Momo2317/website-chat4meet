---
import { Image } from "astro:assets";
import { site } from "../config/site";
import wordmark from "../assets/brand/chat4meet_white_logo.png";

const { appStore, playStore, storesAvailable } = site.storeLinks;
---

<section id="download" class="scroll-mt-24 relative overflow-hidden bg-brand py-24 text-white" aria-labelledby="download-heading">
  <div class="ambient-orb left-10 top-8 h-56 w-56 bg-white/25"></div>
  <div class="ambient-orb bottom-0 right-8 h-64 w-64 bg-brand-deep/50" style="animation-delay:-5s"></div>

  <div class="site-shell relative text-center">
    <div class="reveal">
      <Image
        src={wordmark}
        alt={site.name}
        width={220}
        height={74}
        class="mx-auto h-auto w-[min(220px,70vw)]"
      />
      <h2 id="download-heading" class="mt-8 text-3xl font-bold tracking-tight md:text-4xl">
        Ready when you are
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-white/80">
        {
          storesAvailable
            ? "Download Chat4Meet and start with a conversation that already feels familiar."
            : "Store links are coming soon. The buttons below are ready — we’ll unlock them the moment Chat4Meet ships."
        }
      </p>
    </div>

    <div class="reveal reveal-delay-1 mt-10 flex flex-col items-stretch justify-center gap-4 sm:flex-row sm:items-center">
      <a
        href={appStore}
        class:list={[
          "cta-primary min-w-[11rem]",
          storesAvailable ? "bg-white text-brand" : "pointer-events-none cursor-not-allowed bg-white/35 text-white",
        ]}
        aria-disabled={!storesAvailable}
        tabindex={storesAvailable ? 0 : -1}
      >
        App Store
      </a>
      <a
        href={playStore}
        class:list={[
          "cta-secondary min-w-[11rem]",
          storesAvailable ? "" : "pointer-events-none cursor-not-allowed border-white/35 text-white/60",
        ]}
        aria-disabled={!storesAvailable}
        tabindex={storesAvailable ? 0 : -1}
      >
        Google Play
      </a>
    </div>
  </div>
</section>
