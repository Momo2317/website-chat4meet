---
import { Image } from "astro:assets";
import { journeySteps } from "../config/site";
import story1 from "../assets/brand/stories/story_1.png";
import story3 from "../assets/brand/stories/story_3.png";
import story4 from "../assets/brand/stories/story_4.png";
import mark from "../assets/brand/chat_logo_1024x1024_009c9c.png";

const step = journeySteps[2];
---

<section id={step.id} class="scroll-mt-24 bg-surface-soft py-20 md:py-28" aria-labelledby="profiles-heading">
  <div class="site-shell grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div class="reveal">
      <h2 id="profiles-heading" class="text-3xl font-bold tracking-tight text-ink md:text-4xl">
        {step.label}: {step.title}
      </h2>
      <p class="mt-4 max-w-prose text-[17px] leading-relaxed text-ink-muted">
        {step.description}
      </p>
      <ul class="mt-8 space-y-3">
        {
          step.points.map((point) => (
            <li class="flex gap-3 text-[15px] text-ink">
              <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-brand" aria-hidden="true" />
              <span>{point}</span>
            </li>
          ))
        }
      </ul>
      <a href="#trust" class="mt-10 inline-flex items-center gap-2 text-sm font-semibold text-brand transition hover:gap-3">
        Why Chat4Meet
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="reveal reveal-delay-1">
      <div class="relative mx-auto max-w-sm">
        <div class="absolute -left-4 top-10 h-28 w-28 rounded-full bg-brand/15 blur-2xl" aria-hidden="true"></div>
        <div class="relative overflow-hidden rounded-[1.75rem] border border-surface-border bg-white shadow-soft">
          <div class="h-28 bg-gradient-to-br from-brand to-brand-deep"></div>
          <div class="relative -mt-12 px-6 pb-6">
            <div class="story-ring inline-block">
              <Image src={story1} alt="" width={96} height={96} class="h-24 w-24 object-cover" />
            </div>
            <div class="mt-4 flex items-start justify-between gap-3">
              <div>
                <p class="text-xl font-bold text-ink">Your profile</p>
                <p class="mt-1 text-sm text-ink-muted">Connections · Stories · Posts</p>
              </div>
              <Image src={mark} alt="" width={36} height={36} class="h-9 w-9 rounded-xl" />
            </div>
            <div class="mt-5 grid grid-cols-3 gap-2">
              {
                [story1, story3, story4].map((img) => (
                  <Image
                    src={img}
                    alt=""
                    width={140}
                    height={140}
                    class="aspect-square rounded-xl object-cover"
                  />
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
