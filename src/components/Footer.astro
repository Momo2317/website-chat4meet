---
import { site } from "../config/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-surface-border bg-surface-soft px-6 py-10">
  <div class="site-shell flex flex-col items-center gap-3 text-center text-sm text-ink-muted">
    <p>© {year} {site.name}</p>
    <p class="max-w-md">
      Legal pages (imprint & privacy) will land before public launch.
    </p>
  </div>
</footer>
