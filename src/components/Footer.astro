---
import { site } from "../config/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-surface-border bg-surface-soft px-6 py-10">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-2 text-center text-sm text-ink-muted">
    <p>
      © {year} {site.name}
    </p>
    <p class="max-w-md text-sm">
      Impressum und Datenschutz sind für den öffentlichen Launch noch in Planung.
    </p>
  </div>
</footer>
