---
import { navLinks, site } from "../config/site";
import mark from "../assets/brand/chat-logo-hero-white.svg?url";
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-brand/80 backdrop-blur-md transition-[background,box-shadow] duration-300"
  data-site-header
>
  <div class="site-shell flex h-16 items-center justify-between gap-4">
    <a href="#top" class="flex items-center gap-2.5 text-white" aria-label={`${site.name} home`}>
      <img src={mark} alt="" width="28" height="28" class="h-7 w-7" />
      <span class="text-[17px] font-semibold tracking-tight">{site.name}</span>
    </a>
    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-white/80 transition hover:text-white"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <a
      href="#download"
      class="rounded-full bg-white px-4 py-2 text-sm font-semibold text-brand transition hover:bg-white/90"
    >
      Get the app
    </a>
  </div>
</header>
