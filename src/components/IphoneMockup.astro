---
import { Image } from "astro:assets";
import frame from "../assets/device/phone-mockup-frame.png";
---

<figure class="phone-mock hero-rise">
  <div class="phone-mock__well">
    <slot />
  </div>
  <Image
    class="phone-mock__frame"
    src={frame}
    alt=""
    width={1000}
    height={2136}
    loading="eager"
    decoding="async"
  />
</figure>

<style>
  .phone-mock {
    position: relative;
    width: min(100%, 300px);
    margin: 0 auto;
    aspect-ratio: 1000 / 2136;
    filter: drop-shadow(0 24px 42px rgba(40, 20, 70, 0.28));
  }

  .phone-mock__well {
    position: absolute;
    /* Measured transparent screen hole in phone-mockup-frame.png */
    inset: 7.8% 6.5% 9.3% 7.4%;
    overflow: hidden;
    border-radius: 28px;
    background: #111;
  }

  .phone-mock__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    user-select: none;
  }

  .phone-mock__well :global(img) {
    max-width: none;
  }
</style>
