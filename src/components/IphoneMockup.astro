---
import { Image } from "astro:assets";
import frame from "../assets/device/phone-mockup-frame.png";
---

<figure class="phone-mock hero-rise">
  <div class="phone-mock__shadow" aria-hidden="true"></div>
  <div class="phone-mock__device">
    <div class="phone-mock__well">
      <slot />
    </div>
    <Image
      class="phone-mock__frame"
      src={frame}
      alt=""
      width={1000}
      height={2136}
      loading="eager"
      decoding="async"
    />
  </div>
</figure>

<style>
  .phone-mock {
    position: relative;
    width: min(100%, 300px);
    margin: 0 auto;
  }

  .phone-mock__shadow {
    position: absolute;
    left: 12%;
    right: 12%;
    bottom: -2%;
    height: 10%;
    border-radius: 50%;
    background: rgb(20 10 40 / 0.35);
    filter: blur(18px);
    z-index: 0;
  }

  .phone-mock__device {
    position: relative;
    z-index: 1;
    aspect-ratio: 1000 / 2136;
  }

  .phone-mock__well {
    position: absolute;
    inset: 7.2% 6.2% 8.7% 6.9%;
    overflow: hidden;
    border-radius: 22px;
    background: #f4fbfb;
    z-index: 0;
  }

  .phone-mock__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    user-select: none;
    z-index: 2;
  }
</style>
