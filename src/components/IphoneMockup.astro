---
import frameUrl from "../assets/device/iphone-frame.svg?url";
---

<figure class="phone-mock hero-rise">
  <div class="phone-mock__well">
    <slot />
  </div>
  <img
    class="phone-mock__frame"
    src={frameUrl}
    alt=""
    width="390"
    height="844"
    decoding="async"
  />
</figure>

<style>
  .phone-mock {
    position: relative;
    width: min(100%, 300px);
    margin: 0 auto;
    aspect-ratio: 390 / 844;
    filter: drop-shadow(0 24px 40px rgba(0, 35, 35, 0.32));
  }

  .phone-mock__well {
    position: absolute;
    /* Matches ~10px SVG bezel (27/390 ≈ 6.9%, 20/844 ≈ 2.4%) */
    inset: 2.4% 6.9% 2.4%;
    overflow: hidden;
    border-radius: 34px;
    background: #111;
  }

  .phone-mock__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    user-select: none;
  }

  .phone-mock__well :global(img) {
    max-width: none;
  }
</style>
