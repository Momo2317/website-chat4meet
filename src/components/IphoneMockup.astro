---
/**
 * Realistic iPhone 16 Pro-style device chrome around a slot of UI.
 * Screen content is provided via the default slot.
 */
---

<div class="iphone-device hero-rise" aria-hidden="false">
  <div class="iphone-side iphone-side-left" aria-hidden="true">
    <span class="iphone-btn silent"></span>
    <span class="iphone-btn vol-up"></span>
    <span class="iphone-btn vol-down"></span>
  </div>
  <div class="iphone-side iphone-side-right" aria-hidden="true">
    <span class="iphone-btn power"></span>
  </div>
  <div class="iphone-body">
    <div class="iphone-glass">
      <div class="iphone-island" aria-hidden="true"></div>
      <div class="iphone-screen">
        <slot />
      </div>
    </div>
  </div>
</div>

<style>
  .iphone-device {
    position: relative;
    width: min(100%, 300px);
    margin-inline: auto;
    filter: drop-shadow(0 28px 50px rgba(0, 40, 40, 0.35));
  }

  .iphone-body {
    position: relative;
    border-radius: 3rem;
    padding: 11px;
    background: linear-gradient(145deg, #5c5f66 0%, #2b2d31 28%, #8a8d94 52%, #3a3c42 78%, #1c1d20 100%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.28),
      inset 0 0 0 2px rgba(0, 0, 0, 0.35);
  }

  .iphone-glass {
    position: relative;
    border-radius: 2.45rem;
    overflow: hidden;
    background: #000;
    aspect-ratio: 9 / 19.5;
  }

  .iphone-island {
    position: absolute;
    top: 11px;
    left: 50%;
    z-index: 5;
    width: 28%;
    height: 22px;
    transform: translateX(-50%);
    border-radius: 999px;
    background: #0a0a0a;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  .iphone-screen {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #f4fbfb;
  }

  .iphone-side {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 4px;
    pointer-events: none;
  }

  .iphone-side-left {
    left: -3px;
  }

  .iphone-side-right {
    right: -3px;
  }

  .iphone-btn {
    position: absolute;
    left: 0;
    right: 0;
    display: block;
    border-radius: 2px;
    background: linear-gradient(90deg, #6a6d74, #3d4046);
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.35);
  }

  .silent {
    top: 18%;
    height: 18px;
  }

  .vol-up {
    top: 26%;
    height: 36px;
  }

  .vol-down {
    top: 36%;
    height: 36px;
  }

  .power {
    top: 28%;
    height: 62px;
  }
</style>
