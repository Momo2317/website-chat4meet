---
/**
 * Classic phone silhouette: photo + UI live in the screen well,
 * SVG frame sits on top so the device always reads as an iPhone.
 */
import frameUrl from "../assets/device/iphone-frame.svg?url";
---

<figure class="phone-mock hero-rise">
  <div class="phone-mock__well">
    <slot />
  </div>
  <img
    class="phone-mock__frame"
    src={frameUrl}
    alt=""
    width="390"
    height="844"
    decoding="async"
  />
</figure>

<style>
  .phone-mock {
    position: relative;
    width: min(100%, 320px);
    margin: 0 auto;
    aspect-ratio: 390 / 844;
    filter: drop-shadow(0 30px 55px rgba(0, 35, 35, 0.4));
  }

  .phone-mock__well {
    position: absolute;
    /* Matches SVG screen hole (~95/390 x, 28/844 y …) */
    inset: 3.3% 6.2% 3.1%;
    overflow: hidden;
    border-radius: 34px;
    background: #111;
  }

  .phone-mock__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    user-select: none;
  }

  .phone-mock__well :global(img) {
    max-width: none;
  }
</style>
