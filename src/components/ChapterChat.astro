---
import { Image } from "astro:assets";
import { journeySteps } from "../config/site";
import story4 from "../assets/brand/stories/story_4.png";
import story5 from "../assets/brand/stories/story_5.png";

const step = journeySteps[0];
---

<section id={step.id} class="scroll-mt-24 bg-surface py-20 md:py-28" aria-labelledby="chat-heading">
  <div class="site-shell grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div class="reveal order-2 lg:order-1">
      <h2 id="chat-heading" class="text-3xl font-bold tracking-tight text-ink md:text-4xl">
        {step.label}: {step.title}
      </h2>
      <p class="mt-4 max-w-prose text-[17px] leading-relaxed text-ink-muted">
        {step.description}
      </p>
      <ul class="mt-8 space-y-3">
        {
          step.points.map((point) => (
            <li class="flex gap-3 text-[15px] text-ink">
              <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-brand" aria-hidden="true" />
              <span>{point}</span>
            </li>
          ))
        }
      </ul>
      <a href="#stories" class="mt-10 inline-flex items-center gap-2 text-sm font-semibold text-brand transition hover:gap-3">
        Next: Stories
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="reveal reveal-delay-1 order-1 lg:order-2">
      <div class="relative mx-auto max-w-md">
        <div class="absolute -inset-6 rounded-[2rem] bg-brand-soft blur-2xl" aria-hidden="true"></div>
        <div class="relative overflow-hidden rounded-[1.75rem] border border-surface-border bg-white p-5 shadow-soft">
          <div class="mb-4 flex items-center justify-between">
            <p class="font-semibold text-ink">Tonight’s plans</p>
            <span class="text-xs font-medium text-brand">Active</span>
          </div>
          <div class="space-y-3">
            <div class="flex items-end gap-2">
              <Image src={story4} alt="" width={36} height={36} class="h-9 w-9 rounded-full object-cover" />
              <div class="max-w-[80%] rounded-2xl rounded-bl-md bg-surface-soft px-3.5 py-2.5 text-sm text-ink">
                Are you free after 7?
              </div>
            </div>
            <div class="flex justify-end">
              <div class="max-w-[80%] rounded-2xl rounded-br-md bg-brand px-3.5 py-2.5 text-sm text-white">
                Yes — send me the pin.
              </div>
            </div>
            <div class="flex items-end gap-2">
              <Image src={story5} alt="" width={36} height={36} class="h-9 w-9 rounded-full object-cover" />
              <div class="overflow-hidden rounded-2xl border border-surface-border">
                <Image src={story5} alt="Shared chat media from Chat4Meet" width={280} height={180} class="h-36 w-full object-cover" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
