---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import JourneyGuide from "../components/JourneyGuide.astro";
import ChapterChat from "../components/ChapterChat.astro";
import ChapterStories from "../components/ChapterStories.astro";
import ChapterProfiles from "../components/ChapterProfiles.astro";
import Trust from "../components/Trust.astro";
import Download from "../components/Download.astro";
import Footer from "../components/Footer.astro";
import { site } from "../config/site";
---

<Layout title={`${site.name} — Real connections`} description={site.description}>
  <SiteHeader />
  <main>
    <Hero />
    <JourneyGuide />
    <ChapterChat />
    <ChapterStories />
    <ChapterProfiles />
    <Trust />
    <Download />
  </main>
  <Footer />
  <script src="../scripts/guide.ts"></script>
</Layout>
